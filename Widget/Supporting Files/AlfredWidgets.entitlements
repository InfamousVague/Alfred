<?xml version="1.0" encoding="UTF-8"?>
<!--
  AlfredWidgets extension entitlements. Widget extensions on macOS
  must be sandboxed — pkd (PlugInKit daemon) rejects any plugin
  without `com.apple.security.app-sandbox = true` and logs
  "plug-ins must be sandboxed; mis-configured plugin", which is
  exactly what happens if this file is left as an empty <dict/>.

  We share the host's App Group so the widget's TimelineProvider can
  read SharedStats out of the Group Container. No file-read scopes —
  every disk operation happens in the host process via IntentBus +
  AlfredStore, keeping the destructive code path outside the
  extension's sandbox.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>F6ZAL7ANAD.group.com.mattssoftware.alfred</string>
  </array>
</dict>
</plist>
